{
  "name": "huishouden-health",
  "private": true,
  "license": "PolyForm-Shield-1.0.0",
  "version": "1.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3008 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "bun test src",
    "e2e": "playwright test e2e/smoke.spec.ts e2e/sample.spec.ts e2e/i18n.spec.ts",
    "e2e:signed-in": "playwright test e2e/signed-in.spec.ts",
    "screenshots": "playwright test e2e/screenshots.spec.ts",
    "icons": "pwa-logo pill public/icon.svg && pwa-icons --background=#1b4332",
    "prepare": "git config core.hooksPath .githooks",
    "env:pull": "gh variable list --json name,value -q '.[] | select(.name|startswith(\"VITE_\")) | \"\\(.name)=\\(.value)\"' > .env.local && echo 'wrote .env.local'"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@huishouden/pwa-kit": "github:huishouden/pwa-kit#v0.87.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
